{
	"name" : "user-friendly/smp",
	"description" : "A Multi-User Dungeon, in PHP. Crazy right?",
	"type" : "project",
	"version": "1.0.0-alpha1",
	"license" : "proprietary",
	"authors" : [{
			"name" : "Plamen Ivanov",
			"email" : "pivanov@user-friendly.dev"
		}
	],
	"minimum-stability" : "dev",
	"prefer-stable" : true,
	"require" : {
		"php" : "^8.1",
		"symfony/event-dispatcher" : "^5.2",
		"symfony/config" : "^5.2",
		"symfony/yaml" : "^5.2",
		"monolog/monolog" : "^2.2"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5"
	},
	"autoload" : {
		"psr-4" : {
			"Smp\\" : "Smp/",
			"Smp\\tests\\" : "tests/",
			"Smp\\scripts\\" : "scripts/"
		}
	}
}
