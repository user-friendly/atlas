#             $(BOOST_CHRONO_LIB) \
#             $(BOOST_LOG_LIB) -lboost_atomic \
#             $(BOOST_THREAD_LIB) \
#             $(BOOST_REGEX_LIB) 

bin_PROGRAMS = atlas
atlas_SOURCES = src/main.cpp

# atlas_CFLAGS = $(AM_CFLAGS) $(CFLAGS_PCH)
# atlas_CXXFLAGS = $(AM_CXXFLAGS) $(CXXFLAGS_PCH)
atlas_LDADD = $(TOP_BOOST_LIBS)

