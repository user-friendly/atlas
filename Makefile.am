AM_CXXFLAGS = $(WARN_CXXFLAGS)
AM_LDFLAGS = $(BOOST_LDFLAGS) -Wl,-rpath,./libs/lib -Wl,-rpath,../libs/lib

# Logging lib requires Boost's atomic, probably because it's multi-threaded.
TOP_BOOST_LIBS = $(BOOST_FILESYSTEM_LIB) \
                    $(BOOST_RANDOM_LIB)
